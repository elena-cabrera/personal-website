---
import { faviconUrl } from '../data/collections';
import type { CollectionItem } from '../data/collections';
import {
  isLandingItem,
  isLaunchVideoItem,
  landingSubpagePath,
  launchVideoSubpagePath,
} from '../data/collections';

interface Props {
  item: CollectionItem;
}

const { item } = Astro.props;

const search = [
  item.title,
  item.description,
  item.author,
  item.note,
  item.company,
  item.type,
  ...item.tags,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

const isBook = item.type === 'book';
const isLanding = isLandingItem(item);
const isLaunchVideo = isLaunchVideoItem(item);
const isInternal = isLanding || isLaunchVideo;
const href = isLanding
  ? landingSubpagePath(item.slug)
  : isLaunchVideo
    ? launchVideoSubpagePath(item.slug)
    : item.url;
const previewUrl = isLaunchVideo ? (item.productUrl ?? item.url) : item.url;
---

<li
  class="collection-card group rounded-lg p-2 -m-2 hover:bg-gray-100 dark:hover:bg-zinc-900 transition-colors duration-200"
  data-collection-item
  data-type={item.type}
  data-tags={item.tags.join(' ')}
  data-search={search}
  data-preview-url={previewUrl}
>
  <a
    href={href}
    target={isInternal ? undefined : '_blank'}
    rel={isInternal ? undefined : 'noopener noreferrer'}
    class="flex gap-3 items-start"
  >
    {
      isBook && item.cover ? (
        <img
          src={item.cover}
          alt=""
          width="44"
          height="66"
          class="collection-card__cover"
          loading="lazy"
        />
      ) : isBook ? (
        <span class="collection-card__mark" aria-hidden="true">
          {item.title.slice(0, 1)}
        </span>
      ) : isLaunchVideo && item.video?.poster ? (
        <img
          src={item.video.poster}
          alt=""
          width="44"
          height="28"
          class="collection-card__poster"
          loading="lazy"
        />
      ) : (
        <img
          src={faviconUrl(isLaunchVideo ? (item.productUrl ?? item.url) : item.url)}
          alt=""
          width="16"
          height="16"
          class="collection-card__icon"
          loading="lazy"
        />
      )
    }
    <div class="min-w-0 flex-1">
      <h3
        class="text-[0.95rem] font-semibold leading-snug text-gray-900 dark:text-white transition-colors"
      >
        {item.title}
      </h3>
      {
        isBook || item.description ? (
          <p class="mt-0.5 text-sm text-gray-500 dark:text-zinc-500 transition-colors">
            {isBook
              ? [item.author, item.year].filter(Boolean).join(' · ')
              : isLaunchVideo && item.company
                ? `${item.company} · ${item.description}`
                : item.description}
          </p>
        ) : null
      }
      {
        item.rating ? (
          <p class="collection-card__rating" aria-label={`${item.rating} out of 5`}>
            {'★'.repeat(item.rating)}
            <span class="opacity-30">{'★'.repeat(5 - item.rating)}</span>
          </p>
        ) : null
      }
      <p class="collection-card__tags">
        {item.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </p>
    </div>
  </a>
</li>
