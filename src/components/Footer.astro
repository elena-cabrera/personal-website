---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
const wrapClass = wide ? 'max-w-6xl px-6' : 'max-w-[46rem] px-4';
---

<footer
  class:list={[
    'text-xs text-gray-400 dark:text-zinc-500 border-t border-gray-100 dark:border-zinc-900 py-5 mx-auto transition-colors',
    wrapClass,
  ]}
>
  © 2026 Elena Cabrera Casquet. All rights reserved.
</footer>
