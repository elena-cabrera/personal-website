---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout>
  <main class="px-4 py-16 flex flex-col gap-20 max-w-[46rem] mx-auto">
    <section id="hero" class="flex gap-4 items-start">
      <img
        src="/assets/images/profile/me.jpg"
        alt="Elena Cabrera Casquet profile picture"
        class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover flex-shrink-0"
      />
      <div class="min-w-0">
        <p
          class="text-base sm:text-lg leading-relaxed text-gray-600 dark:text-zinc-400 transition-colors"
        >
          <span
            class="font-semibold text-gray-900 dark:text-white transition-colors"
            >hi, I'm Elena.</span
          >
          I am a Builder. I enjoy creating software products and solving problems in
          creative ways.
        </p>
        <p class="flex gap-2 items-center mt-2">
          <a
            class="hover:opacity-80 hover:rotate-12 transition-all duration-200 text-zinc-900 dark:text-zinc-100 transition-colors"
            href="https://www.linkedin.com/in/elena-cabrera-casquet/"
            aria-label="LinkedIn"
          >
            <svg preserveAspectRatio="xMidYMid" viewBox="0 0 256 256" class="w-5 h-5">
              <path
                d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"
                fill="currentColor"></path>
            </svg>
          </a>
          <a
            class="hover:opacity-80 hover:rotate-12 transition-all duration-200 text-zinc-900 dark:text-zinc-100"
            href="https://github.com/elena-cabrera"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 1024 1024" fill="none" class="w-5 h-5">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
                transform="scale(64)"
                fill="currentColor"></path>
            </svg>
          </a>
          <a
            class="hover:opacity-80 hover:rotate-12 transition-all duration-200 text-zinc-900 dark:text-zinc-100"
            href="https://x.com/elena928_"
            aria-label="X"
          >
            <svg fill="none" viewBox="0 0 1200 1227" class="w-4 h-4" stroke="currentColor">
              <path
                fill="currentColor"
                d="M714.163 519.284 1160.89 0h-105.86L667.137 450.887 357.328 0H0l468.492 681.821L0 1226.37h105.866l409.625-476.152 327.181 476.152H1200L714.137 519.284h.026ZM569.165 687.828l-47.468-67.894-377.686-540.24h162.604l304.797 435.991 47.468 67.894 396.2 566.721H892.476L569.165 687.854v-.026Z"
              ></path>
            </svg>
          </a>
        </p>
      </div>
    </section>

    <section id="about-me" class="scroll-mt-14" data-reveal-group>
      <h2 class="section-title" data-reveal>about me</h2>
      <div class="space-y-4">
        <p class="prose-body transition-colors" data-reveal>
          Based in <span class="prose-em">Madrid</span>, but originally from
          <span class="prose-em">Lanzarote</span>. Always enjoyed building stuff and
          learning new things, I guess that's why I'm drawn to startups and
          entrepreneurship.
        </p>
        <p class="prose-body transition-colors" data-reveal>
          I love reading, cooking, and traveling. I also enjoy spending time with my
          loved ones and my dog, especially out in nature. Occasionally surfing… but
          honestly, not very good at it.
        </p>
      </div>
    </section>

    <section id="work" class="scroll-mt-14" data-reveal-group>
      <h2 class="section-title" data-reveal>work</h2>
      <p class="prose-body transition-colors" data-reveal>
        I started my career as a Business Consultant and transitioned into a
        <span class="prose-em">Product Engineer</span> role at a
        <span class="prose-em">startup</span>, where I've been able to combine my
        <span class="prose-em">technical</span> skills with my
        <span class="prose-em">communication and leadership</span> skills, finding that
        I love bringing products <span class="prose-em">from idea to reality</span>.
      </p>
      <ul class="mt-10 space-y-8 list-none pl-0">
        <li
          class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-5 gap-y-2 items-start"
          data-reveal-row
        >
          <span class="work-date">2023 — Now</span>
          <div class="min-w-0">
            <h3 class="work-role transition-colors">
              <span>Lead Product Engineer</span>
              <span class="work-role__at">@</span>
              <a href="https://www.switchfleet.com/" class="work-company">
                <img
                  src="/assets/images/work/switchfleet.png"
                  alt=""
                  width="16"
                  height="16"
                  class="work-company__logo"
                  loading="lazy"
                />
                <span>SwitchFleet</span>
              </a>
            </h3>
            <div class="mt-1.5" data-work-expand>
              <p class="work-expandable prose-body transition-colors">
                I lead the Product Team at SwitchFleet, a Spanish startup that creates
                software solutions to help companies measure and reduce their fleet's
                carbon footprint. I'm responsible for the product strategy and
                delivery. Since I joined, I've developed the company's data pipeline and
                built a B2B SaaS web application from scratch, from the initial idea to
                the MVP and beyond.
              </p>
              <button type="button" class="work-expand-btn" hidden>read more</button>
            </div>
          </div>
        </li>
        <li
          class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-5 gap-y-2 items-start"
          data-reveal-row
        >
          <span class="work-date">2021 — 2023</span>
          <div class="min-w-0">
            <h3 class="work-role transition-colors">
              <span>New Technologies Consultant</span>
              <span class="work-role__at">@</span>
              <a href="https://www.managementsolutions.com/" class="work-company">
                <img
                  src="/assets/images/work/management-solutions.png"
                  alt=""
                  width="16"
                  height="16"
                  class="work-company__logo"
                  loading="lazy"
                />
                <span>Management Solutions</span>
              </a>
            </h3>
            <div class="mt-1.5" data-work-expand>
              <p class="work-expandable prose-body transition-colors">
                Led digital transformation projects at a top-tier European bank,
                focusing on technology and risks. Designed and implemented global fraud
                detection systems and coordinated their rollout across markets,
                including SWIFT operations and real-time alert systems. Managed the
                integration of a new equity derivatives orchestrator, aligning business
                and tech teams following the Agile / Scrum methodology.
              </p>
              <button type="button" class="work-expand-btn" hidden>read more</button>
            </div>
          </div>
        </li>
        <li
          class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-5 gap-y-2 items-start"
          data-reveal-row
        >
          <span class="work-date">2021</span>
          <div class="min-w-0">
            <h3 class="work-role transition-colors">
              <span>Utilities Consultant Internship</span>
              <span class="work-role__at">@</span>
              <a href="https://www.nttdata.com/" class="work-company">
                <img
                  src="/assets/images/work/nttdata.png"
                  alt=""
                  width="16"
                  height="16"
                  class="work-company__logo"
                  loading="lazy"
                />
                <span>NTT Data</span>
              </a>
            </h3>
            <p class="mt-1.5 prose-body transition-colors">
              Supported kickoff, GAP analysis, and requirements/scope definition for the
              migration of a major utility's trading system at an IBEX 35 energy company.
            </p>
          </div>
        </li>
      </ul>
    </section>

    <section id="tech-stack" class="scroll-mt-14" data-reveal-group>
      <h2 class="section-title" data-reveal>tech stack</h2>
      <p class="prose-body transition-colors" data-reveal>
        As a developer, I've worked with the following technologies. I particularly
        enjoy working with Python and FastAPI, but I'm also comfortable with frontend
        technologies.
      </p>
      <ul class="mt-6 flex flex-wrap justify-between gap-y-5 list-none pl-0">
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/python.webp" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >Python</span
          >
        </li>
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/fastapi.png" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >FastAPI</span
          >
        </li>
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/vuejs.webp" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >Vue.js</span
          >
        </li>
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/react.webp" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >React</span
          >
        </li>
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/nextjs.svg" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >Next.js</span
          >
        </li>
        <li class="tech-sticker" data-reveal>
          <div class="tech-sticker__logo">
            <img src="/assets/images/stack/docker.svg" alt="" loading="lazy" />
          </div>
          <span class="text-xs text-gray-500 dark:text-zinc-500 transition-colors"
            >Docker</span
          >
        </li>
      </ul>
    </section>

    <section id="projects" class="scroll-mt-14" data-reveal-group>
      <h2 class="section-title" data-reveal>projects</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-2 list-none pl-0">
        <li
          class="group rounded-lg p-1 -m-2 hover:bg-gray-100 dark:hover:bg-zinc-900 hover:shadow-sm transition-all duration-200"
          data-reveal
        >
          <a
            href="https://markdown-os.elenacabrera.xyz"
            target="_blank"
            rel="noopener noreferrer"
            class="block overflow-hidden rounded-lg font-medium text-gray-700 hover:text-gray-900 dark:text-zinc-300 dark:hover:text-white transition-colors"
          >
            <div
              class="aspect-video bg-zinc-200 dark:bg-zinc-800 overflow-hidden rounded-t-lg"
            >
              <img
                src="https://v1.screenshot.11ty.dev/https%3A%2F%2Fmarkdown-os.elenacabrera.xyz%2F/width/800/"
                alt="markdown-os preview"
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3
                class="text-lg font-semibold text-gray-900 dark:text-white transition-colors mb-1"
              >
                markdown-os
              </h3>
              <p class="text-sm text-gray-500 dark:text-zinc-400 transition-colors">
                View and edit Markdown files in the browser, improving on IDE default
                preview.
              </p>
            </div>
          </a>
        </li>
        <li
          class="rounded-lg p-1 -m-2 hover:bg-gray-100 dark:hover:bg-zinc-900 hover:shadow-sm transition-all duration-200 cursor-default"
          data-reveal
        >
          <div class="block overflow-hidden rounded-lg">
            <div
              class="aspect-video bg-zinc-200 dark:bg-zinc-800 rounded-t-lg flex items-center justify-center"
            >
              <span class="text-gray-400 dark:text-zinc-500 text-4xl" aria-hidden="true"
                >…</span
              >
            </div>
            <div class="p-4">
              <h3
                class="text-lg font-semibold text-gray-400 dark:text-zinc-500 transition-colors mb-1"
              >
                more coming…
              </h3>
              <p class="text-sm text-gray-400 dark:text-zinc-500 transition-colors">
                More projects on the way.
              </p>
            </div>
          </div>
        </li>
      </ul>
    </section>

    <section id="blog" class="scroll-mt-14" data-reveal-group>
      <h2 class="section-title" data-reveal>blog</h2>
      <ul class="mt-2 flex flex-col gap-3">
        {
          posts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              date={post.data.date}
              category={post.data.category}
              thumbnail={post.data.thumbnail}
            />
          ))
        }
      </ul>
    </section>

    <p id="contact" class="scroll-mt-14 prose-body transition-colors" data-reveal>
      Always looking for a nice chat. Say hi on
      <a
        href="https://www.linkedin.com/in/elena-cabrera-casquet/"
        class="font-medium text-gray-700 hover:text-gray-900 dark:text-zinc-300 dark:hover:text-white transition-colors"
        >LinkedIn</a
      >.
    </p>
  </main>

  <script>
    import '../scripts/work-expand.js';
    import '../scripts/scroll-timeline.js';
    import '../scripts/reveal.js';
  </script>
</BaseLayout>
