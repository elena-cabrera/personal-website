          <p class="lab-signature lab-signature--static">Elena</p>
        </article>
      </div>
    </section>
  </main>

  <script>
    const animated = document.querySelectorAll<HTMLElement>(
      '.lab-circled:not(.lab-circled--static), .lab-signature:not(.lab-signature--static)'
    );
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-drawn');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    animated.forEach((el) => observer.observe(el));

    document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((button) => {
      button.addEventListener('click', () => {
        const block = document.getElementById(button.dataset.replay ?? '');
        block?.querySelectorAll('.is-drawn').forEach((el) => {
          el.classList.remove('is-drawn');
          void (el as HTMLElement).offsetWidth;
          el.classList.add('is-drawn');
        });
      });
    });
  </script>
